# SQLite by default. Set to Postgres in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/digital_twin
DATABASE_URL=sqlite:///./digital_twin.db

# CORS: comma separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

# Application dashboard URL (embedded into SMS alert links)
DASHBOARD_URL=http://localhost:8080/dashboard

# ── SMS Alert Gateway Configuration ──────────────────────────────────────────
# Set to 'true' to enable SMS dispatch for Warning and Critical events
SMS_ENABLED=false

# Provider choice: 'simulator' (safe mock testing), 'twilio' (Global/India), or 'fast2sms' (India)
SMS_PROVIDER=simulator

# Cooldown window in minutes to suppress repeated SMS for the same continuous incident
SMS_COOLDOWN_MINUTES=30

# Recipient mobile numbers with country code (+91 for India, comma-separated for multiple)
# Example: +919876543210,+919876543211
OPERATOR_PHONE_NUMBER=

# ── Twilio Provider Credentials (Required only if SMS_PROVIDER=twilio) ──────
# Create account at https://www.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Fast2SMS Credentials (Required only if SMS_PROVIDER=fast2sms) ───────────
# Create account at https://www.fast2sms.com/
FAST2SMS_API_KEY=
